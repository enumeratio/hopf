{
  "name": "@enumeratio/hopf",
  "version": "0.0.0",
  "private": true,
  "description": "Combinatorial Hopf algebra extensions for @cortex-js/compute-engine: NSym and QSym on compositions, with product, coproduct and antipode.",
  "license": "WTFPL",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enumeratio/hopf.git"
  },
  "files": [
    "dist",
    "reference",
    "docs"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./notation": {
      "types": "./dist/notation.d.mts",
      "import": "./dist/notation.mjs"
    },
    "./declares.json": "./dist/declares.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "enumeratio-collect-notation . && vp pack && enumeratio-collect-declares .",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@enumeratio/boxes": "^0.1.0-next.1",
    "@enumeratio/engine": "^0.1.0-next.1",
    "@enumeratio/structures": "^0.1.0-next.1"
  },
  "devDependencies": {
    "@cortex-js/compute-engine": "^0.147.0",
    "@enumeratio/manifest": "^0.1.0-next.1",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.1",
    "vite-plus": "0.3.1"
  },
  "peerDependencies": {
    "@cortex-js/compute-engine": "^0.147.0"
  },
  "enumeratio": {
    "layer": "extension",
    "area": "algebras",
    "extends": [
      "structures"
    ],
    "notation": "./notation",
    "group": "algebras",
    "declare": "declareHopf",
    "declares": "./declares.json"
  },
  "generated": [
    "src/notation.generated.ts"
  ],
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.18.0"
  }
}
